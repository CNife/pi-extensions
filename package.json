{
  "name": "cnife-pi-extensions",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "pi": {
    "extensions": [
      "personal/*.ts",
      "personal/*/extensions"
    ],
    "skills": [
      "personal/*/skills"
    ]
  },
  "scripts": {
    "check": "biome check . && tsc --noEmit && vitest run",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "check:unsafe": "biome check --write --unsafe .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "proto:timing": "npx tsx packages/auto-naming-session/prototype/first-title-timing/index.ts",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "packages/**/*.ts": [
      "biome check --write"
    ],
    "**/*.md": [
      "rumdl fmt"
    ],
    "**/package.json": [
      "bash -c 'npm install --package-lock-only && git add package-lock.json'",
      "node scripts/check-package-files.mjs"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@earendil-works/pi-ai": "^0.75.5",
    "@earendil-works/pi-coding-agent": "^0.75.5",
    "@earendil-works/pi-tui": "^0.75.5",
    "@types/node": "^25.9.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@juicesharp/rpiv-advisor": "^2.1.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
